<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BBotDB</title>

    <link rel="stylesheet" href="./style.css">
</head>

<body>

    <header>
        <h1>BBotDB</h1>
        <p>The community database for BasketBot cards, stats, lineups, and more.</p>
    </header>

    <main>

        <section>
            <h2>Card Database</h2>
            <p>Search and explore BasketBot cards.</p>

            <button onclick="location.href='cards.html'">
                Search Cards
            </button>

            <button onclick="location.href='cards.html'">
                Browse Cards
            </button>
        </section>

        <section>
            <h2>Traits</h2>
            <p>Explore BasketBot card traits and their available levels.</p>

            <button onclick="location.href='traits.html'">
                Explore Traits
            </button>
        </section>

        <section>
            <h2>Lineups</h2>
            <p>Explore lineups and see where different cards fit.</p>

            <button>
                Explore Lineups
            </button>
        </section>

        <section>
            <h2>Statistics</h2>
            <p>View game statistics, streaks, team usage, and other data.</p>

            <button>
                View Statistics
            </button>
        </section>

        <section>
            <h2>Community</h2>
            <p>Submit information and help keep the database updated.</p>

            <button>
                Submit Data
            </button>
        </section>

    </main>

    <footer>
        <p>BBotDB — Community BasketBot Database</p>
    </footer>

</body>

</html>